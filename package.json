{
  "name": "vidnitebot",
  "private": true,
  "version": "1.0.0",
  "author": "s <https://github.com/lostfictions>",
  "license": "AGPL-3.0",
  "description": "a bot that posts on bluesky.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "NODE_ENV=production node --experimental-strip-types src/main.ts",
    "profile": "NODE_ENV=production node --experimental-strip-types src/profile.ts",
    "dev": "NODE_ENV=development node --experimental-strip-types src/main.ts --local",
    "dev:profile": "NODE_ENV=development node --experimental-strip-types src/profile.ts --local",
    "test": "run-p -cl test:*",
    "test:ts": "tsc --noEmit",
    "test:eslint": "eslint --color 'src/**/*'",
    "test:prettier": "prettier 'src/**' -l",
    "prettier": "prettier 'src/**/*' --write"
  },
  "dependencies": {
    "@sentry/node": "^9.8.0",
    "dotenv": "^16.4.7",
    "twoot": "0.4.0",
    "znv": "^0.4.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "eslint": "^9.23.0",
    "eslint-config-lostfictions": "7.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.6.2+sha512.47870716bea1572b53df34ad8647b42962bc790ce2bf4562ba0f643237d7302a3d6a8ecef9e4bdfc01d23af1969aa90485d4cebb0b9638fa5ef1daef656f6c1b"
}
